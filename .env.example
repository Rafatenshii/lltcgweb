# LLTCG web — local / Docker environment (copy to .env)
# See docs/RUNTIME.md for full reference.

# Runtime directories (optional — defaults are repo-relative)
# TCG_DATA_DIR=/var/lltcg/data/
# TCG_GAMES_DIR=/var/lltcg/games/
# TCG_EXPERIMENT_DECKS_DIR=/var/lltcg/experiment_decks/
# TCG_CARDIMG_DIR=/var/lltcg/cardimg/
# TCG_EXPORTS_DIR=/var/lltcg/exports/
# TCG_CARDS_FILE=/var/www/html/cards.json

# CORS (comma-separated browser origins)
# TCG_CORS_ORIGINS=https://loveliveradio.ca,http://localhost:8080

# Auth bootstrap file (production Discord session)
# TCG_LLR_AUTH_FILE=/secrets/llr_auth.php

# Multiplayer sync (optional — disabled when unset)
# TCG_SYNC_SHARED_SECRET=
# TCG_SYNC_PUBLISH_URL=
# TCG_SYNC_INTERNAL_TOKEN=
# TCG_SYNC_ENABLED=0

# Live room store (overhaul Part 1) — file = Hostinger default; redis = VPS match API
# TCG_GAME_STORE=file
# TCG_REDIS_URL=redis://127.0.0.1:6379
# TCG_REDIS_PREFIX=lltcg:room:
# TCG_REDIS_TTL_SEC=172800
# TCG_GAME_SNAPSHOT_DIR=/var/lltcg/game-snapshots/

# Client: force match API origin (empty = Hostinger ./api.php with overflow failover)
# Browser sets window.TCG_MATCH_API_ORIGIN = 'https://stream.loveliveradio.ca/tcg/api'
# Prefer client/js/runtime-flags.js (TCG_MATCH_API_PRIMARY default false until cutover).
# TCG_MATCH_API_PRIMARY=0

# Hostinger only: set to 0 after VPS match-primary cutover so create/join/action cannot write games/*.json
# Leave unset or 1 on the VPS match API. Default = writes allowed.
# Also supported: empty marker file MATCH_WRITES_DISABLED next to api.php (Hostinger-friendly).
# TCG_HOSTINGER_MATCH_WRITES=1

# Ranked VPS cutover (same secret on Hostinger tcg_sync.local.php + VPS match API)
# TCG_INTERNAL_MATCH_SECRET=
# TCG_MATCH_SEED_URL=https://stream.loveliveradio.ca/tcg/api/api.php?action=seed_ranked_room
# TCG_ELO_APPLY_URL=https://loveliveradio.ca/tcg/account.php?action=ranked_apply_result
# TCG_ELO_APPLY_REMOTE=1
# TCG_OVERFLOW_MATCH_API=https://stream.loveliveradio.ca/tcg/api

# Rate limit state directory (defaults to TCG_DATA_DIR/rate_limits/)
# TCG_RATE_LIMIT_DIR=

# Error responses (see docs/SECURITY.md)
# Tournament Mode (default off for the public; allowlist still unlocks preview users)
# TCG_TOURNAMENTS_ENABLED=1
# Comma-separated Discord IDs, or * for open (requires TCG_TOURNAMENTS_ENABLED=1)
# TCG_TOURNAMENT_ALLOWLIST=213038604975472640
# Optional Discord incoming webhook for check-in / bracket start (Hostinger env; do not commit secrets)
# TCG_TOURNAMENT_WEBHOOK_URL=
# Docker compose sets TCG_TOURNAMENTS_ENABLED automatically. Fake Discord login for localhost Hub testing:
# TCG_LOCAL_FAKE_AUTH=1
